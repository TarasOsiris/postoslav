# Postoslav environment — all server-only. Do NOT add a VITE_ prefix to any of
# these; that would expose them to the client bundle. Copy to `.env` to use.

# Optional access gate. When set, every request must present this value via HTTP
# Basic auth (any username, this as the password) EXCEPT the TikTok
# callback/media/domain-verification paths. Set it whenever you expose the app
# through a public tunnel (ngrok / Cloudflare) so that strangers who find the
# tunnel URL can't open your UI or post on your behalf. Leave blank/unset for
# plain localhost development (the gate is then a no-op).
APP_ACCESS_TOKEN=

# Optional. SQLite database file path. Default: data/postoslav.db
# DATABASE_URL=data/postoslav.db

# Optional. Directory where normalized upload JPEGs are stored/served. Default: ./media
# MEDIA_DIR=media
